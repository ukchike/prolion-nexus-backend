PORT=4000
FRONTEND_URL=https://your-nexus-app.vercel.app

# AI Provider Configuration
# 'anthropic' (default) or 'groq' (free, console.groq.com)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Supabase — verifying the caller's session JWT (middleware/requireAuth.js).
# Every route needs this; the service itself stores nothing in Supabase.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_ANON_KEY=eyJhbGc...

# Supabase — service-role key (lib/supabaseAdmin.js). Bypasses Row Level
# Security entirely, so it is deliberately separate from the anon key
# above and used in exactly two places: routes/team.js (inviting a
# teammate via the Auth Admin API, reading/writing company_members across
# an authorization check the route enforces itself) and everything under
# lib/entitlementService.js / routes/billing.js (reading a company's plan
# and usage, metering AI credits, activating a subscription after
# payment — all across the same RLS boundary a normal client can't cross).
# Get it from Supabase Dashboard -> Project Settings -> API -> service_role
# key (the "secret" one, not "anon" / "public"). Missing this produces:
#   "SUPABASE_URL (or SUPABASE_PROJECT_ID) and SUPABASE_SERVICE_KEY must
#   be set to manage team membership."
# — thrown from ANY route that touches team membership or billing, not
# only team invites, despite what the message says.
SUPABASE_SERVICE_KEY=eyJhbGc...

# Invoice emailing (routes/invoices.js, lib/emailProvider.js). Both must
# be set together — either without the other leaves "Email an invoice"
# failing with a config error rather than actually sending.
RESEND_API_KEY=re_...
INVOICE_FROM_EMAIL=billing@yourdomain.com

# Billing — Paystack (lib/paystack.js, routes/billing.js). Get the secret
# key from the Paystack dashboard -> Settings -> API Keys & Webhooks (use
# the TEST secret key while developing). Also set the same value as the
# webhook's signing secret when you register
# https://your-backend.onrender.com/api/billing/webhook as the webhook URL
# in the Paystack dashboard — that URL is what actually activates a
# subscription after a successful payment.
PAYSTACK_SECRET_KEY=sk_test_...
# Optional — only Paystack is implemented today; kept for when a second
# provider (e.g. Flutterwave) is added (see lib/paymentProvider.js).
PAYMENT_PROVIDER=paystack
# Optional — where Paystack redirects the browser after checkout. Omit to
# use Paystack's own default return page.
BILLING_CALLBACK_URL=https://your-nexus-app.vercel.app/settings?tab=plan
